# ===========================================================================
# La Bonne Table — règles d'ignorance communes à tout le dépôt
# Les règles propres à l'application Front-End sont dans frontend/.gitignore
# ===========================================================================

# --- Système d'exploitation ------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Éditeurs / IDE --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Dépendances & artefacts de build --------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
*.tsbuildinfo

# --- Secrets & variables d'environnement ----------------------------------
.env
.env.*
!.env.example
*.local

# --- Journaux & fichiers temporaires ---------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
