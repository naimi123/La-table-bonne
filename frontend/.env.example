# ---------------------------------------------------------------------------
# La Bonne Table — variables d'environnement Front-End
# Copier ce fichier vers `.env.local` puis adapter les valeurs.
# Ne jamais committer de secret (.env et .env.* sont ignorés par Git).
# ---------------------------------------------------------------------------

# URL de base de l'API Back-End (sera branchée par le développeur Back-End).
VITE_API_BASE_URL=http://localhost:4000/api

# "true"  -> utilise les services simulés (aucun serveur requis) — défaut Sprint 1
# "false" -> appelle réellement VITE_API_BASE_URL
VITE_USE_MOCK_API=true
